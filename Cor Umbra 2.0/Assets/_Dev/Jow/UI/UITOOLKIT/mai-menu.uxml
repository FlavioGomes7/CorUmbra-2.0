<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Dev/Jow/UI/UITOOLKIT/MenuStyle.uss?fileID=7433441132597879392&amp;guid=94355c1b68e88fc41bb070397551b7bf&amp;type=3#MenuStyle" />
    <Style src="project://database/Assets/_Dev/Jow/UI/UITOOLKIT/SliderCustomized.uss?fileID=7433441132597879392&amp;guid=59f623e3a53e7d149a162fd17e00bd6b&amp;type=3#SliderCustomized" />
    <ui:VisualElement name="VisualElement-Base" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-color: rgb(0, 0, 0); padding-top: 80px; padding-right: 80px; padding-bottom: 80px; padding-left: 80px; display: flex; visibility: visible; overflow: visible; color: rgba(27, 27, 27, 0);">
        <ui:VisualElement name="VisualElement-Buttons" class="main-menu" style="width: 650px; margin-right: 160px; margin-left: 120px; padding-bottom: 0; margin-bottom: 25px; background-color: rgba(0, 0, 0, 0); justify-content: flex-start; align-items: stretch; align-self: flex-start;">
            <ui:VisualElement name="VisualElement" style="background-image: url(&apos;project://database/Assets/_Dev/Jow/UI/NanoPunkTitle.png?fileID=2800000&amp;guid=42cb06cb7f98df745a257c9806ead450&amp;type=3#NanoPunkTitle&apos;); width: 610px; height: 250px; scale: 1 1; transform-origin: top; -unity-background-scale-mode: stretch-to-fill; translate: 0 0; flex-direction: column; flex-wrap: nowrap; flex-basis: 200px; align-self: auto; display: none;" />
            <ui:VisualElement name="BaseMenu" style="flex-grow: 1; min-width: initial; min-height: initial; padding-top: 20px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 40px; padding-right: 0; padding-bottom: 0; padding-left: 0; width: auto; height: auto; justify-content: center; display: flex; align-items: stretch;">
                <ui:Button text="INICIAR JOGO" display-tooltip-when-elided="true" name="StartButton" class="main-menu-buttons" />
                <ui:Button text="CONFIGURAÇÕES" display-tooltip-when-elided="true" name="OptionsButton" class="main-menu-buttons" />
                <ui:Button text="SAIR DO JOGO" display-tooltip-when-elided="true" name="ExitButton" class="main-menu-buttons" />
            </ui:VisualElement>
            <ui:VisualElement name="OptionsMenu" style="flex-grow: 1; min-height: initial; padding-top: 20px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 40px; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 1520px; height: auto; justify-content: flex-start; display: none; align-items: stretch;">
                <ui:Label tabindex="-1" text="C:\ CONFIGURAÇÕES" display-tooltip-when-elided="true" style="-unity-text-outline-color: rgba(255, 255, 255, 0); color: rgb(31, 31, 31); background-color: rgb(255, 136, 0); font-size: 36px; margin-top: 20px; margin-right: 0; margin-bottom: 100px; margin-left: 0; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; justify-content: flex-start; align-items: stretch; align-self: stretch; width: auto;" />
                <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: auto; justify-content: space-evenly; height: 125px; flex-wrap: wrap;">
                    <ui:Slider label="BRILHO" value="1" high-value="4" low-value="0" name="Slider-brilho" class="unity-slider" />
                    <ui:Slider label="Sensibilidade MOUSE" value="1" high-value="4" low-value="0" name="Slider-sensibilidade" class="unity-slider" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row; align-items: auto; justify-content: space-evenly; height: 125px; flex-wrap: wrap;">
                    <ui:Slider label="PRINCIPAL SOUND" value="1" high-value="4" low-value="1" name="Slider-principalSound" class="unity-slider" />
                    <ui:Slider label="SOUND FX" value="1" high-value="4" low-value="1" name="Slider-soundFX" class="unity-slider" />
                </ui:VisualElement>
                <ui:Button text="Voltar" display-tooltip-when-elided="true" name="BackButton" class="main-menu-buttons" style="width: 560px; align-self: flex-start; align-items: auto; bottom: 0; position: absolute; left: auto; right: auto; top: auto;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Brigthness-screen" style="flex-grow: 1; padding-top: 80px; padding-right: 80px; padding-bottom: 80px; padding-left: 80px; align-items: auto; justify-content: space-evenly; display: none; flex-direction: row; overflow: visible; visibility: visible; align-self: stretch; background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/_Dev/Jow/Scripts/UI-BRIGHTNESS.renderTexture?fileID=8400000&amp;guid=92bce737c3a5ae648acfe6678d7a7b15&amp;type=2#UI-BRIGHTNESS&apos;);">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 128px; width: auto; align-items: stretch; justify-content: center; align-self: flex-end; flex-direction: row; min-width: auto; min-height: auto; position: relative; top: auto; left: auto; right: auto; bottom: auto; background-color: rgba(0, 0, 0, 0.7);">
            <ui:Slider label="BRILHO" value="1" high-value="4" low-value="0" name="Slider-brilho" class="unity-slider" style="display: flex; width: 741px; min-height: auto; align-self: stretch;" />
            <ui:Button text="PRONTO?" display-tooltip-when-elided="true" name="readyButton" enable-rich-text="true" class="main-menu-buttons" style="align-items: auto; justify-content: flex-start; height: 50px; align-self: center; width: 207px; margin-right: 4px; margin-left: 150px; margin-top: 0; translate: 0 5px; visibility: hidden;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
