<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="InventoryCanvas" style="flex-grow: 1; flex-basis: auto; width: 800px; height: 450px; flex-direction: column; position: absolute; top: 300px; left: auto; right: auto; bottom: auto; align-self: center; background-color: rgba(0, 0, 0, 0.54); -unity-text-outline-width: 20px; -unity-text-outline-color: rgb(255, 95, 0); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
        <ui:VisualElement name="item_Name" style="flex-grow: 1; justify-content: flex-start; align-items: auto; flex-direction: row; -unity-text-outline-width: 0; -unity-text-outline-color: rgba(255, 95, 0, 0); height: ; width: 743px; align-self: flex-start; font-size: 20px;">
            <ui:Label tabindex="-1" text="Munição" display-tooltip-when-elided="true" style="flex-direction: row; align-self: center; align-items: auto;" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; height: 282px;">
            <ui:VisualElement name="item_icon" style="flex-grow: 1; justify-content: flex-start; align-items: auto; flex-direction: row; -unity-text-outline-width: 0; -unity-text-outline-color: rgba(255, 95, 0, 0); height: 138px; width: 279px;" />
            <ui:VisualElement name="item_Description" style="flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
