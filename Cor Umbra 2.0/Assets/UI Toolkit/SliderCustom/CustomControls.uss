#Game-Slider Label {
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    align-items: center;
    display: flex;
    visibility: visible;
    width: 75%;
    align-self: center;
    translate: 15% 0;
    -unity-text-align: middle-left;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    white-space: normal;
    text-overflow: clip;
}

#Game-Slider #unity-drag-container {
    background-color: rgb(0, 0, 0);
    align-items: center;
    opacity: 1;
    transition-property: all, ignored;
    transition-duration: 0s, 0s;
    transition-timing-function: ease, ease;
    transition-delay: 0s, 0s;
    align-self: center;
    justify-content: flex-start;
    translate: -105% 0;
    transform-origin: center;
    width: 100px;
    height: 15px;
    margin-top: 15px;
    margin-bottom: 15px;
    margin-left: 0;
    margin-right: 0;
}

#Game-Slider #unity-tracker {
    background-color: rgb(38, 38, 38);
    position: relative;
    top: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    left: auto;
    right: auto;
    bottom: auto;
    transform-origin: center;
    width: 100%;
    height: 50%;
    align-items: center;
    align-self: center;
    translate: 0 50%;
}

#Game-Slider #unity-dragger {
    background-color: rgb(255, 244, 0);
    width: 10px;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    top: 0;
    left: 0;
}
